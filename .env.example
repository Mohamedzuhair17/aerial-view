# Copy this file to .env. Change every placeholder secret before deployment.

# --- model execution ---
# Set INSTALL_ML=1 for CPU PyTorch in Docker. For GPU use a CUDA-specific image.
INSTALL_ML=0
MODEL_MODE=auto
DEVICE=cpu
CHANGE_WEIGHTS=runs/unet_train_only/checkpoints/best_changeformer_detector.pdparams
CHANGE_INPUT_SIZE=512
CHANGE_SCORE_THRESH=0.25
CHANGE_NMS_IOU=0.50
UNET_WEIGHTS=runs/unet_train_only/checkpoints/unet_best.pth
UNET_INPUT_SIZE=256
MIN_CONF=0.40
MIN_BUILDING_AREA=150

# --- LLM ---
LLM_PROVIDER=none
LLM_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# --- API / security ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_UPLOAD_MB=25
MAX_IMAGE_SIDE=2048
MAX_IMAGE_PIXELS=12000000
API_KEY=
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_MAX_CLIENTS=10000
JOB_RETENTION_HOURS=72
JOB_STALE_HOURS=3
CLEANUP_INTERVAL_SECONDS=3600

# --- job queue ---
JOB_QUEUE_BACKEND=inline
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_NAME=aerial

# --- registration ---
REGISTRATION_ENABLED=true
REGISTRATION_MIN_MATCHES=12
REGISTRATION_MIN_INLIER_RATIO=0.20
REGISTRATION_MIN_OVERLAP=0.60
REQUIRE_ALIGNMENT=false
MAX_ASPECT_RATIO_DELTA=0.02

# ChangeFormer TorchScript model input size is fixed at 256 in this implementation.
CHANGE_TILE_SIZE=256
CHANGE_TILE_OVERLAP=32

# --- database ---
DATABASE_BACKEND=sqlite
DATABASE_URL=
POSTGRES_DB=aerial_db
POSTGRES_USER=aerial
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_PORT=5432

# Set true when you want GeoTIFF ingestion (requires requirements-geo.txt).
GEOSPATIAL_ENABLED=true
GEOTIFF_VALUE_MIN=0
GEOTIFF_VALUE_MAX=10000
